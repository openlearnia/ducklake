{
  "name": "openlearnia-ducklake-wasm-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "preview": "vite preview",
    "deploy": "npm run build && rm -f dist/runtime/*.wasm && wrangler deploy"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.11.0",
    "apache-arrow": "^17.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
