# name: test/sql/constraints/unsupported.test
# description: test unsupported constraints
# group: [constraints]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}


statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_unsupported_files')

# PRIMARY KEY and UNIQUE are accepted as unenforced metadata - see
# test/sql/constraints/unenforced_primary_key.test. FOREIGN KEY is still
# unsupported because recording it needs core support.
statement ok
CREATE TABLE ducklake.main.other(i INTEGER PRIMARY KEY);

statement error
CREATE TABLE ducklake.main.test(i INTEGER, j INTEGER, FOREIGN KEY (j) REFERENCES ducklake.main.other(i));
----
not supported

statement error
CREATE TABLE ducklake.test(i INTEGER, j INTEGER,  CHECK (i > j));
----
not supported
