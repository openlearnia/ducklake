# name: test/sql/delete/vortex_delete_add_files_creates_delete_dir.test
# description: Vortex twin of delete_add_files_creates_delete_dir
# group: [delete]

require ducklake

require vortex

test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db

test-env DATA_PATH __TEST_DIR__

statement ok
SET ducklake_default_data_file_format = 'vortex';

statement ok
ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/vortex_delete_add_files_creates_delete_dir', DATA_INLINING_ROW_LIMIT 5, METADATA_CATALOG 'ducklake_meta')

statement ok
USE ducklake

statement ok
CREATE TABLE t(id INTEGER)

statement ok
COPY (SELECT i::INTEGER AS id FROM range(100) t(i)) TO '${DATA_PATH}/vortex_delete_add_files_source.vortex' (FORMAT vortex)

statement ok
CALL ducklake_add_data_files('ducklake', 't', '${DATA_PATH}/vortex_delete_add_files_source.vortex')

query I
SELECT count(*) FROM t
----
100

statement ok
DELETE FROM t WHERE id BETWEEN 10 AND 40

query I
SELECT count(*) FROM t
----
69

query I
SELECT count(*) FROM ducklake_meta.ducklake_delete_file WHERE end_snapshot IS NULL
----
1