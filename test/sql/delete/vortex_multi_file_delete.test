# name: test/sql/delete/vortex_multi_file_delete.test
# description: Repeated deletes preserve undeleted rows in a multi-file Vortex table
# group: [delete]

require ducklake

require vortex

statement ok
SET ducklake_default_data_file_format='vortex'

statement ok
SET ducklake_default_data_inlining_row_limit=0

statement ok
ATTACH 'ducklake:__TEST_DIR__/vortex_multi_file_delete.db' AS ducklake (DATA_PATH '__TEST_DIR__/vortex_multi_file_delete_files')

statement ok
CREATE TABLE ducklake.test(i INTEGER)

statement ok
INSERT INTO ducklake.test VALUES (1)

statement ok
INSERT INTO ducklake.test VALUES (2)

statement ok
INSERT INTO ducklake.test VALUES (3)

statement ok
INSERT INTO ducklake.test VALUES (NULL)

statement ok
INSERT INTO ducklake.test FROM range(10, 15)

statement ok
DELETE FROM ducklake.test WHERE i=2

statement ok
DELETE FROM ducklake.test WHERE i=11

statement ok
DELETE FROM ducklake.test WHERE i=12

query I
SELECT * FROM ducklake.test ORDER BY ALL
----
1
3
10
13
14
NULL

query II
SELECT format, delete_count
FROM __ducklake_metadata_ducklake.ducklake_delete_file
WHERE end_snapshot IS NULL
----
vortex	2
