# name: test/sql/procedures/test_nested_procedure_drop_conflict.test
# description: Dropping a parent schema conflicts with concurrent procedure creation in its child
# group: [procedures]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{TEST_DIR}/nested_procedure_drop_conflict')

statement ok
SET immediate_transaction_mode=true

statement ok
CREATE SCHEMA ducklake.parent;

statement ok
CREATE SCHEMA ducklake.parent.child;

statement ok con1
BEGIN

statement ok con2
BEGIN

statement ok con1
CREATE PROCEDURE ducklake.parent.child.add_one(value INTEGER)
RETURNS INTEGER
LANGUAGE JAVASCRIPT
AS $$
return value + 1;
$$;

statement ok con2
DROP SCHEMA ducklake.parent CASCADE;

statement ok con1
COMMIT

statement error con2
COMMIT
----
attempting to drop schema with name "parent" - but another transaction has created an entry in this schema

query I
CALL ducklake.parent.child.add_one(41);
----
42
