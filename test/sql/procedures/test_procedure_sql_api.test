# name: test/sql/procedures/test_procedure_sql_api.test
# description: persisted DuckLake JavaScript procedures can execute SQL
# group: [procedures]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/test_procedure_sql_api.db

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{TEST_DIR}/test_procedure_sql_api');

statement ok
USE ducklake

statement ok
CREATE TABLE procedure_values(value INTEGER);

statement ok
CREATE PROCEDURE append_and_count(value INTEGER)
RETURNS INTEGER
LANGUAGE JAVASCRIPT
AS $$
  await duckdb.execute('INSERT INTO ducklake.main.procedure_values VALUES ($1)', [value]);
  const rows = await duckdb.query('SELECT count(*) AS row_count FROM ducklake.main.procedure_values');
  return rows[0].row_count;
$$;

query I
CALL append_and_count(7);
----
1

query I
CALL append_and_count(9);
----
2

query I
SELECT sum(value) FROM procedure_values;
----
16

# Promise.all submits work in order while retaining one serialized invocation connection.

statement ok
CREATE PROCEDURE async_append_batch(value INTEGER)
RETURNS INTEGER
LANGUAGE JAVASCRIPT
AS $$
  const results = await Promise.all([
    duckdb.execute('INSERT INTO ducklake.main.procedure_values VALUES ($1)', [value]),
    duckdb.execute('INSERT INTO ducklake.main.procedure_values VALUES ($1)', [value + 1]),
    duckdb.query('SELECT count(*) AS row_count FROM ducklake.main.procedure_values')
  ]);
  return results[2][0].row_count;
$$;

query I
CALL async_append_batch(13);
----
4

query I
SELECT sum(value) FROM procedure_values;
----
43

# Explicit transaction callbacks commit all DuckLake writes together.

statement ok
CREATE PROCEDURE append_transactionally(value INTEGER)
RETURNS INTEGER
LANGUAGE JAVASCRIPT
AS $$
  await duckdb.transaction(async () => {
    await duckdb.execute('INSERT INTO ducklake.main.procedure_values VALUES ($1)', [value]);
    await Promise.resolve();
    await duckdb.execute('INSERT INTO ducklake.main.procedure_values VALUES ($1)', [value + 1]);
  });
  return (await duckdb.query('SELECT count(*) AS row_count FROM ducklake.main.procedure_values'))[0].row_count;
$$;

query I
CALL append_transactionally(20);
----
6

query I
SELECT sum(value) FROM procedure_values;
----
84

# A callback failure rolls back all writes in the DuckLake transaction.

statement ok
CREATE PROCEDURE rollback_transaction(value INTEGER)
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
AS $$
  try {
    await duckdb.transaction(async () => {
      await duckdb.execute('INSERT INTO ducklake.main.procedure_values VALUES ($1)', [value]);
      throw new Error('abort transaction');
    });
  } catch (e) {
    return e.message;
  }
  return 'no error';
$$;

query T
CALL rollback_transaction(99);
----
abort transaction

query I
SELECT count(*) FROM procedure_values;
----
6

statement ok
USE memory;

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{TEST_DIR}/test_procedure_sql_api');

statement ok
USE ducklake

query I
CALL append_and_count(11);
----
7

query I
SELECT count(*) FROM procedure_values;
----
7
