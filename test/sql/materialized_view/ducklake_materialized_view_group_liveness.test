# name: test/sql/materialized_view/ducklake_materialized_view_group_liveness.test
# description: refresh removes groups whose final base row was deleted
# group: [materialized_view]

require ducklake

require parquet

statement ok
ATTACH 'ducklake:__TEST_DIR__/mv_group_liveness.db' AS ducklake (DATA_PATH '__TEST_DIR__/mv_group_liveness_files')

statement ok
CREATE TABLE ducklake.base(grp INTEGER, val INTEGER)

statement ok
INSERT INTO ducklake.base VALUES (1, 5)

statement ok
SELECT * FROM ducklake_create_materialized_view('ducklake', view_name := 'mv', query := 'SELECT grp, sum(val) AS total FROM base GROUP BY grp')

statement ok
DELETE FROM ducklake.base

# Without COUNT(*) in the materialized output, delta state cannot prove that the
# group disappeared. Use key recomputation rather than manufacturing SUM=0.
query T
SELECT refresh_mode FROM ducklake_refresh_materialized_view('ducklake', view_name := 'mv')
----
incremental

query I
SELECT count(*) FROM ducklake.mv
----
0
