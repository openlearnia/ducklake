# name: test/sql/materialized_view/ducklake_materialized_view_transaction.test
# description: materialized view refresh observes transaction-local dependency changes
# group: [materialized_view]

require ducklake

require parquet

statement ok
ATTACH 'ducklake:__TEST_DIR__/mv_transaction.db' AS ducklake (DATA_PATH '__TEST_DIR__/mv_transaction_files')

statement ok
CREATE TABLE ducklake.base(grp INTEGER, val INTEGER)

statement ok
INSERT INTO ducklake.base VALUES (1, 10)

statement ok
SELECT * FROM ducklake_create_materialized_view('ducklake', view_name := 'mv', query := 'SELECT grp, sum(val) AS total FROM base GROUP BY grp')

statement ok
BEGIN TRANSACTION

statement ok
INSERT INTO ducklake.base VALUES (1, 5)

# The catalog snapshot has not advanced, but the dependency is dirty in this transaction.
# Delta CDC only covers committed snapshots, so refresh must take the full path.
query T
SELECT refresh_mode FROM ducklake_refresh_materialized_view('ducklake', view_name := 'mv')
----
full

statement ok
COMMIT

query II
SELECT grp, total FROM ducklake.mv
----
1	15
