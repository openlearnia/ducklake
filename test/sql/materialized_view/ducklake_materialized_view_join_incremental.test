# name: test/sql/materialized_view/ducklake_materialized_view_join_incremental.test
# description: fact-only join-incremental refresh for single INNER equijoin MVs
# group: [materialized_view]

require ducklake

require parquet

statement ok
ATTACH 'ducklake:__TEST_DIR__/mv_join_inc.db' AS ducklake (DATA_PATH '__TEST_DIR__/mv_join_inc_files')

statement ok
CREATE TABLE ducklake.fact AS SELECT i AS id, i AS dim_id, 1 AS v FROM range(10) t(i)

statement ok
CREATE TABLE ducklake.dim AS SELECT i AS dim_id, 'g' || (i % 2)::VARCHAR AS g FROM range(10) t(i)

statement ok
SELECT * FROM ducklake_create_materialized_view('ducklake', view_name := 'jv',
  query := 'SELECT d.g, sum(f.v) AS s FROM fact f JOIN dim d ON f.dim_id = d.dim_id GROUP BY d.g')

statement ok
INSERT INTO ducklake.fact VALUES (100, 0, 5)

query T
SELECT refresh_mode FROM ducklake_refresh_materialized_view('ducklake', view_name := 'jv')
----
join_incremental

query II
SELECT g, s FROM ducklake.jv ORDER BY g
----
g0	10
g1	5

# dim-only change → full
statement ok
UPDATE ducklake.dim SET g = 'x' WHERE dim_id = 1

query T
SELECT refresh_mode FROM ducklake_refresh_materialized_view('ducklake', view_name := 'jv')
----
full

# An aggregate over a dimension-side value is outside the fact-only contract.
statement ok
SELECT * FROM ducklake_create_materialized_view('ducklake', view_name := 'dim_agg',
  query := 'SELECT d.g, sum(d.dim_id) AS s FROM fact f JOIN dim d ON f.dim_id = d.dim_id GROUP BY d.g')

statement ok
INSERT INTO ducklake.fact VALUES (101, 0, 5)

query T
SELECT refresh_mode FROM ducklake_refresh_materialized_view('ducklake', view_name := 'dim_agg')
----
full

# The equality must connect both relations, not merely filter the fact side.
statement ok
SELECT * FROM ducklake_create_materialized_view('ducklake', view_name := 'same_side_join',
  query := 'SELECT d.g, sum(f.v) AS s FROM fact f JOIN dim d ON f.id = f.dim_id GROUP BY d.g')

statement ok
INSERT INTO ducklake.fact VALUES (102, 0, 5)

query T
SELECT refresh_mode FROM ducklake_refresh_materialized_view('ducklake', view_name := 'same_side_join')
----
full

# Unqualified measures cannot be proven fact-only at parse-analysis time.
statement ok
SELECT * FROM ducklake_create_materialized_view('ducklake', view_name := 'unqualified_measure',
  query := 'SELECT d.g, sum(v) AS s FROM fact f JOIN dim d ON f.dim_id = d.dim_id GROUP BY d.g')

statement ok
INSERT INTO ducklake.fact VALUES (103, 0, 5)

query T
SELECT refresh_mode FROM ducklake_refresh_materialized_view('ducklake', view_name := 'unqualified_measure')
----
full
