# name: test/sql/materialized_view/ducklake_materialized_view_qualified_columns.test
# description: incremental refresh supports columns qualified by an unaliased base table name
# group: [materialized_view]

require ducklake

require parquet

statement ok
ATTACH 'ducklake:__TEST_DIR__/mv_qualified_columns.db' AS ducklake (DATA_PATH '__TEST_DIR__/mv_qualified_columns_files')

statement ok
CREATE TABLE ducklake.base(grp INTEGER, val INTEGER)

statement ok
INSERT INTO ducklake.base VALUES (1, 10)

query I
SELECT refresh_mode FROM ducklake_create_materialized_view('ducklake', view_name := 'qualified_mv', query := 'SELECT base.grp, sum(base.val) AS total, count(*) AS row_count, count(base.val) AS value_count FROM base GROUP BY base.grp')
----
full

statement ok
INSERT INTO ducklake.base VALUES (1, 5), (2, 7)

query I
SELECT refresh_mode FROM ducklake_refresh_materialized_view('ducklake', view_name := 'qualified_mv')
----
delta

query III
SELECT grp, total, row_count FROM ducklake.qualified_mv ORDER BY grp
----
1	15	2
2	7	1
