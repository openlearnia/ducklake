# name: test/sql/materialized_view/ducklake_materialized_view_txn_local_staleness.test
# description: uncommitted changes to a dependency make the MV stale within the same transaction
# group: [materialized_view]

require notwindows

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok con1
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_DIR}/mv_txn_local')

statement ok con1
CREATE TABLE dl.src (x INTEGER)

statement ok con1
INSERT INTO dl.src VALUES (1), (2)

statement ok con1
CREATE MATERIALIZED VIEW dl.mv AS SELECT sum(x) AS s FROM dl.src

statement ok con1
REFRESH MATERIALIZED VIEW dl.mv

query I
SELECT s FROM dl.mv
----
3

# an insert inside an open transaction: the source table shows the new row, the view must not
# silently serve the old aggregate under the error policy
statement ok con1
BEGIN

statement ok con1
SELECT * FROM dl.src

statement ok con1
INSERT INTO dl.src VALUES (10)

statement ok con1
SET ducklake_mv_stale_read = 'error'

statement error con1
SELECT s FROM dl.mv
----
Materialized view "mv" is stale

statement ok con1
ROLLBACK

# after rollback the view is fresh again
statement ok con1
SET ducklake_mv_stale_read = 'error'

query I
SELECT s FROM dl.mv
----
3
