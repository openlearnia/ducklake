# name: test/sql/materialized_view/ducklake_materialized_view_refresh_history.test
# description: DuckLake materialized view refresh history persists successful refreshes
# group: [materialized_view]

require ducklake

require parquet

statement ok
ATTACH 'ducklake:{TEST_DIR}/mv_refresh_history.db' AS ducklake (DATA_PATH '{TEST_DIR}/mv_refresh_history_files')

statement ok
CREATE TABLE ducklake.base AS SELECT 1 AS id, 10 AS value

statement ok
INSERT INTO ducklake.base VALUES (2, 20)

statement ok
CREATE MATERIALIZED VIEW ducklake.mv AS
SELECT id, sum(value) AS total FROM ducklake.base GROUP BY id

query III
SELECT rows_added, rows_removed, rows_changed
FROM ducklake_materialized_view_refresh_history('ducklake')
WHERE view_name = 'mv'
ORDER BY refresh_snapshot
LIMIT 1
----
2	0	0

statement ok
INSERT INTO ducklake.base VALUES (1, 15), (3, 30)

query T
SELECT refresh_mode FROM ducklake_refresh_materialized_view('ducklake', view_name := 'mv')
----
incremental

query III
SELECT rows_added, rows_removed, rows_changed
FROM ducklake_materialized_view_refresh_history('ducklake')
WHERE view_name = 'mv'
ORDER BY refresh_snapshot DESC
LIMIT 1
----
1	0	1

statement ok
DELETE FROM ducklake.base WHERE id = 2

query T
SELECT refresh_mode FROM ducklake_refresh_materialized_view('ducklake', view_name := 'mv')
----
incremental

query III
SELECT rows_added, rows_removed, rows_changed
FROM ducklake_materialized_view_refresh_history('ducklake')
WHERE view_name = 'mv'
ORDER BY refresh_snapshot DESC
LIMIT 1
----
0	1	0

query TTTI
SELECT refresh_mode, rows_refreshed, refresh_snapshot > 0, refresh_time IS NOT NULL
FROM ducklake_materialized_view_refresh_history('ducklake')
WHERE view_name = 'mv'
ORDER BY refresh_snapshot
----
full	2	true	true
incremental	3	true	true
incremental	2	true	true

query TTTTTTTT
SELECT refresh_duration_ms >= 0,
       rows_written = rows_refreshed,
       rows_added >= 0,
       rows_removed >= 0,
       rows_changed >= 0,
       source_snapshot > 0,
       source_snapshot_time IS NOT NULL,
       lag_ms >= 0
FROM ducklake_materialized_view_refresh_history('ducklake')
WHERE view_name = 'mv'
ORDER BY refresh_snapshot DESC
LIMIT 1
----
true	true	true	true	true	true	true	true
