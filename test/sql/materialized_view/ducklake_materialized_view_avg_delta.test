# name: test/sql/materialized_view/ducklake_materialized_view_avg_delta.test
# description: AVG is delta-maintained only when matching SUM and COUNT state is persisted
# group: [materialized_view]

require ducklake

require parquet

statement ok
ATTACH 'ducklake:__TEST_DIR__/mv_avg_delta.db' AS ducklake (DATA_PATH '__TEST_DIR__/mv_avg_delta_files')

statement ok
CREATE TABLE ducklake.b(id INTEGER, grp INTEGER, val INTEGER)

statement ok
INSERT INTO ducklake.b VALUES (1, 1, 10), (2, 1, 20), (3, 2, NULL)

statement ok
SELECT * FROM ducklake_create_materialized_view('ducklake', view_name := 'safe_avg',
  query := 'SELECT grp, sum(val) AS total, count(val) AS value_count, count(*) AS row_count, avg(val) AS mean FROM b GROUP BY grp')

statement ok
INSERT INTO ducklake.b VALUES (4, 1, 30), (5, 2, 8)

query T
SELECT refresh_mode FROM ducklake_refresh_materialized_view('ducklake', view_name := 'safe_avg')
----
delta

query IIIIR
SELECT grp, total, value_count, row_count, mean FROM ducklake.safe_avg ORDER BY grp
----
1	60	3	3	20.0
2	8	1	2	8.0

statement ok
DELETE FROM ducklake.b WHERE id IN (1, 3, 5)

query T
SELECT refresh_mode FROM ducklake_refresh_materialized_view('ducklake', view_name := 'safe_avg')
----
delta

query IIIIR
SELECT grp, total, value_count, row_count, mean FROM ducklake.safe_avg ORDER BY grp
----
1	50	2	2	25.0

statement ok
SELECT * FROM ducklake_create_materialized_view('ducklake', view_name := 'unsafe_avg',
  query := 'SELECT grp, avg(val) AS mean, count(*) AS row_count FROM b GROUP BY grp')

statement ok
INSERT INTO ducklake.b VALUES (6, 1, 50)

query T
SELECT refresh_mode FROM ducklake_refresh_materialized_view('ducklake', view_name := 'unsafe_avg')
----
incremental
