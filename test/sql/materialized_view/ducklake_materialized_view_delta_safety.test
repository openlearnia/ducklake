# name: test/sql/materialized_view/ducklake_materialized_view_delta_safety.test
# description: delta refresh preserves aggregate semantics across supported select-list shapes
# group: [materialized_view]

require ducklake

require parquet

statement ok
ATTACH 'ducklake:__TEST_DIR__/mv_delta_safety.db' AS ducklake (DATA_PATH '__TEST_DIR__/mv_delta_safety_files')

statement ok
CREATE TABLE ducklake.key_order_base(grp INTEGER, val INTEGER)

statement ok
INSERT INTO ducklake.key_order_base VALUES (1, 10), (2, 20)

# Group keys need not precede aggregates in the projection.
statement ok
SELECT * FROM ducklake_create_materialized_view('ducklake', view_name := 'key_order_mv', query := 'SELECT sum(val) AS total, count(*) AS row_count, grp, count(val) AS value_count FROM key_order_base GROUP BY grp')

statement ok
INSERT INTO ducklake.key_order_base VALUES (1, 5)

query T
SELECT refresh_mode FROM ducklake_refresh_materialized_view('ducklake', view_name := 'key_order_mv')
----
delta

query III
SELECT total, row_count, grp FROM ducklake.key_order_mv ORDER BY grp
----
15	2	1
20	1	2
