# name: test/sql/materialized_view/native_materialized_view_refresh_history.test
# description: native DuckDB materialized view refresh history persists successful refreshes
# group: [materialized_view]

statement ok
CREATE TABLE base(id INTEGER, value INTEGER)

statement ok
INSERT INTO base VALUES (1, 10)

statement ok
CREATE MATERIALIZED VIEW mv AS SELECT sum(value) AS total FROM base

statement ok
INSERT INTO base VALUES (2, 20)

statement ok
REFRESH MATERIALIZED VIEW mv

statement ok
CHECKPOINT

query TTT
SELECT refresh_mode, refresh_time IS NOT NULL, refresh_ordinal > 0
FROM duckdb_materialized_view_refresh_history()
WHERE view_name = 'mv'
ORDER BY refresh_ordinal
----
full	true	true
delta	true	true

query TTTTTTT
SELECT refresh_duration_ms >= 0,
       rows_written >= 0,
       rows_added IS NULL,
       rows_removed IS NULL,
       rows_changed IS NULL,
       source_snapshot_time IS NULL,
       lag_ms IS NULL
FROM duckdb_materialized_view_refresh_history()
WHERE view_name = 'mv'
ORDER BY refresh_ordinal DESC
LIMIT 1
----
true	true	true	true	true	true	true
