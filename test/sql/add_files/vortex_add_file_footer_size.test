# name: test/sql/add_files/vortex_add_file_footer_size.test
# description: Vortex twin — footer_size persisted as non-null (>= 0; Vortex uses 0)
# group: [add_files]

require ducklake

require vortex

test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db

test-env DATA_PATH __TEST_DIR__


statement ok
SET ducklake_default_data_file_format = 'vortex';

statement ok
ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/ducklake_empty_files_vortex/', METADATA_CATALOG 'metadata');

statement ok
CREATE TABLE ducklake.test(col1 INTEGER, col2 VARCHAR);

statement ok
COPY (SELECT 200 col1, 'world' col2) TO '${DATA_PATH}/data.vortex' (FORMAT vortex);

statement ok
CALL ducklake_add_data_files('ducklake', 'test', '${DATA_PATH}/data.vortex')

query I
SELECT data_file_footer_size IS NOT NULL AND data_file_footer_size >= 0 FROM ducklake_list_files('ducklake', 'test')
----
True
