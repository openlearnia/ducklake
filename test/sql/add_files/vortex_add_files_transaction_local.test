# name: test/sql/add_files/vortex_add_files_transaction_local.test
# description: Vortex twin of add_files_transaction_local — external .vortex into txn-local Vortex table
# group: [add_files]

require ducklake

require vortex

test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db

test-env DATA_PATH __TEST_DIR__

statement ok
SET ducklake_default_data_file_format = 'vortex';


statement ok
ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/ducklake_add_files_transaction_local');

statement ok
BEGIN

statement ok
CREATE TABLE ducklake.test(col1 INTEGER, col2 VARCHAR);

# write a vortex file outside of DuckLake
statement ok
COPY (SELECT 1 col1, 'hello world' col2) TO '${DATA_PATH}/my_file.vortex' (FORMAT vortex);

statement ok
CALL ducklake_add_data_files('ducklake', 'test', '${DATA_PATH}/my_file.vortex')

query II
FROM ducklake.test
----
1	hello world

statement ok
COMMIT

query II
FROM ducklake.test
----
1	hello world
