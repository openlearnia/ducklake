# name: test/sql/add_files/vortex_add_files_hive_mismatch.test
# description: Vortex twin of add_files_hive_mismatch.test
# group: [add_files]

require ducklake

require vortex

test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db

test-env DATA_PATH __TEST_DIR__


statement ok
SET ducklake_default_data_file_format = 'vortex';

statement ok
ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/ducklake_add_files_hive_mismatch_vx/', METADATA_CATALOG 'metadata');

statement ok
CREATE TABLE partitioned_tbl(part_key VARCHAR, part_key2 INT, val VARCHAR);

statement ok
INSERT INTO partitioned_tbl VALUES ('p1', 10, 'hello'), ('p2', 10, 'world'), ('p2', 20, 'abc')

statement ok
COPY partitioned_tbl TO '${DATA_PATH}/ducklake_add_files_hive_mismatch_vx/' (FORMAT VORTEX, PARTITION_BY(part_key, part_key2));

statement ok
CREATE TABLE ducklake.test(part_key INT, part_key2 INT, val VARCHAR);

statement error
CALL ducklake_add_data_files('ducklake', 'test', '${DATA_PATH}/ducklake_add_files_hive_mismatch_vx/**/*.vortex', hive_partitioning => true)
----
Unable to cast 'p1' (from hive partition column 'PART_KEY') to: 'INTEGER'

statement ok
CREATE OR REPLACE TABLE ducklake.test(part_key VARCHAR, part_key2 INT, val VARCHAR);

statement ok
CALL ducklake_add_data_files('ducklake', 'test', '${DATA_PATH}/ducklake_add_files_hive_mismatch_vx/**/*.vortex', hive_partitioning => true)

query III
FROM ducklake.test ORDER BY ALL
----
p1	10	hello
p2	10	world
p2	20	abc

statement ok
COPY (SELECT 'p1' part_key, 10 part_key2, 'non_partitioned' val) TO '${DATA_PATH}/ducklake_add_files_hive_mismatch_vx/non_partitioned_file.vortex' (FORMAT VORTEX)

statement ok
CALL ducklake_add_data_files('ducklake', 'test', '${DATA_PATH}/ducklake_add_files_hive_mismatch_vx/non_partitioned_file.vortex')

query III
FROM ducklake.test ORDER BY ALL
----
p1	10	hello
p1	10	non_partitioned
p2	10	world
p2	20	abc
