# name: test/sql/add_files/vortex_add_files_type_check_float.test
# description: Vortex twin of add_files_type_check_float
# group: [add_files]

require ducklake

require vortex

test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db

test-env DATA_PATH __TEST_DIR__

statement ok
SET ducklake_default_data_file_format = 'vortex';


statement ok
ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/ducklake_add_files_type_float')

# create a bunch of vortex files with different types
statement ok
COPY (SELECT true col1) TO '${DATA_PATH}/bool.vortex' (FORMAT vortex)

statement ok
COPY (SELECT 42.0::FLOAT col1) TO '${DATA_PATH}/float.vortex' (FORMAT vortex)

statement ok
COPY (SELECT 42.0::DOUBLE col1) TO '${DATA_PATH}/double.vortex' (FORMAT vortex)

#########
# float #
#########
statement ok
CREATE OR REPLACE TABLE ducklake.test(col1 FLOAT);

foreach UNACCEPTED_TYPE bool double

statement error
CALL ducklake_add_data_files('ducklake', 'test', '${DATA_PATH}/${UNACCEPTED_TYPE}.vortex')
----
FLOAT

endloop

statement ok
CALL ducklake_add_data_files('ducklake', 'test', '${DATA_PATH}/float.vortex')

query I
FROM ducklake.test
----
42.0

#########
# double #
#########
statement ok
CREATE OR REPLACE TABLE ducklake.test(col1 DOUBLE);

statement error
CALL ducklake_add_data_files('ducklake', 'test', '${DATA_PATH}/bool.vortex')
----
FLOAT

foreach ACCEPTED_TYPE float double

statement ok
CALL ducklake_add_data_files('ducklake', 'test', '${DATA_PATH}/${ACCEPTED_TYPE}.vortex')

endloop

query I
FROM ducklake.test
----
42.0
42.0
