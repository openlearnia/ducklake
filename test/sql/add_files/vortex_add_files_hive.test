# name: test/sql/add_files/vortex_add_files_hive.test
# description: Vortex twin of add_files_hive.test — hive-partitioned .vortex add-files
# group: [add_files]

require ducklake

require vortex

test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db

test-env DATA_PATH __TEST_DIR__


statement ok
SET ducklake_default_data_file_format = 'vortex';

statement ok
ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/ducklake_add_files_hive_vx/', METADATA_CATALOG 'metadata', DATA_INLINING_ROW_LIMIT 0);

statement ok
CREATE TABLE partitioned_tbl(part_key INT, part_key2 INT, val VARCHAR);

statement ok
INSERT INTO partitioned_tbl VALUES (1, 10, 'hello'), (2, 10, 'world'), (2, 20, 'abc')

statement ok
COPY partitioned_tbl TO '${DATA_PATH}/ducklake_add_files_hive_vx/' (FORMAT VORTEX, PARTITION_BY(part_key, part_key2));

statement ok
CREATE TABLE ducklake.test(part_key INT, part_key2 INT, val VARCHAR);

# we need the hive partition columns
statement error
CALL ducklake_add_data_files('ducklake', 'test', '${DATA_PATH}/ducklake_add_files_hive_vx/**/*.vortex', hive_partitioning => false)
----
allow_missing

statement ok
CALL ducklake_add_data_files('ducklake', 'test', '${DATA_PATH}/ducklake_add_files_hive_vx/**/*.vortex', hive_partitioning => true)

query III
SELECT part_key, part_key2, val FROM ducklake.test ORDER BY ALL
----
1	10	hello
2	10	world
2	20	abc

# test pushdown into stats
query II
EXPLAIN ANALYZE SELECT COUNT(*) FROM ducklake.test WHERE part_key=1
----
analyzed_plan	<REGEX>:.*Total Files Read: 1.*

query II
EXPLAIN ANALYZE SELECT * FROM ducklake.test WHERE part_key = 1 OFFSET 0 LIMIT 1;
----
analyzed_plan	<REGEX>:.*Total Files Read: 1.*

statement ok
ALTER TABLE ducklake.test RENAME part_key TO new_part_key

query III
SELECT new_part_key, part_key2, val FROM ducklake.test ORDER BY ALL
----
1	10	hello
2	10	world
2	20	abc

statement ok
COPY (FROM (VALUES (1, 10, 'new value')) t(new_part_key, part_key2, val)) TO '${DATA_PATH}/ducklake_add_files_hive_vx/' (FORMAT VORTEX, PARTITION_BY(new_part_key, part_key2), APPEND);

statement ok
CALL ducklake_add_data_files('ducklake', 'test', '${DATA_PATH}/ducklake_add_files_hive_vx/new_part_key=*/**/*.vortex')

query III
SELECT new_part_key, part_key2, val FROM ducklake.test ORDER BY ALL
----
1	10	hello
1	10	new value
2	10	world
2	20	abc

query II
EXPLAIN ANALYZE SELECT COUNT(*) FROM ducklake.test WHERE new_part_key=1
----
analyzed_plan	<REGEX>:.*Total Files Read: 2.*

statement ok
ALTER TABLE ducklake.test ALTER new_part_key SET TYPE BIGINT

query III
SELECT new_part_key, part_key2, val FROM ducklake.test ORDER BY ALL
----
1	10	hello
1	10	new value
2	10	world
2	20	abc
