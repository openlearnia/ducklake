# name: test/sql/add_files/vortex_add_file_specific_schema.test
# description: Vortex twin of add_file_specific_schema
# group: [add_files]

require ducklake

require vortex

test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db

test-env DATA_PATH __TEST_DIR__

statement ok
SET ducklake_default_data_file_format = 'vortex';


statement ok
ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/add_file_specific_schema/', METADATA_CATALOG 'metadata');

statement ok
USE ducklake;

statement ok
CREATE SCHEMA schema_test;

statement ok
CREATE TABLE schema_test.test(col1 INTEGER, col2 VARCHAR);

statement ok
COPY (SELECT 200 col1, 'world' col2) TO '${DATA_PATH}/file.vortex' (FORMAT vortex);

statement error
CALL ducklake_add_data_files('ducklake', 'test', '${DATA_PATH}/file.vortex');
----
Did you mean "schema_test.test"?

statement ok
CALL ducklake_add_data_files('ducklake', 'test', '${DATA_PATH}/file.vortex', schema = 'schema_test');

query II
FROM schema_test.test;
----
200	world