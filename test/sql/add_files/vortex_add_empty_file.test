# name: test/sql/add_files/vortex_add_empty_file.test
# description: Vortex twin of add_empty_file — empty external .vortex
# group: [add_files]

require ducklake

require vortex

test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db

test-env DATA_PATH __TEST_DIR__

statement ok
SET ducklake_default_data_file_format = 'vortex';

statement ok
ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/ducklake_empty_files/', METADATA_CATALOG 'metadata');

statement ok
CREATE TABLE ducklake.test(col1 INTEGER, col2 VARCHAR);

statement ok
INSERT INTO ducklake.test VALUES (100, 'hello');

# write a vortex file outside of DuckLake
statement ok
COPY (SELECT 200 col1, 'world' col2 LIMIT 0) TO '${DATA_PATH}/ducklake_empty_files/main/test/empty_file.vortex' (FORMAT vortex);

statement ok
BEGIN

# make its existence known to DuckLake
statement ok
CALL ducklake_add_data_files('ducklake', 'test', '${DATA_PATH}/ducklake_empty_files/main/test/empty_file.vortex')

query II
FROM ducklake.test
----
100	hello

statement ok
COMMIT

query II
FROM ducklake.test
----
100	hello
