# name: test/sql/add_files/vortex_add_files_nested.test
# description: Vortex twin of add_files_nested
# group: [add_files]

require ducklake

require vortex

test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db

test-env DATA_PATH __TEST_DIR__

statement ok
SET ducklake_default_data_file_format = 'vortex';


statement ok
ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/ducklake_add_files_nested');

statement ok
CREATE TABLE ducklake.test(col1 STRUCT(i INTEGER, j INTEGER), col2 STRUCT(col1 INTEGER, col2 INTEGER));

statement ok
BEGIN

statement ok
COPY (SELECT {'i': 1, 'j': 2} col1, {'col1': 100, 'col2': 200} col2) TO '${DATA_PATH}/nested1.vortex' (FORMAT vortex);

statement ok
CALL ducklake_add_data_files('ducklake', 'test', '${DATA_PATH}/nested1.vortex')

query II
FROM ducklake.test
----
{'i': 1, 'j': 2}	{'col1': 100, 'col2': 200}

statement ok
COMMIT

query II
FROM ducklake.test
----
{'i': 1, 'j': 2}	{'col1': 100, 'col2': 200}

# columns can be arbitrarily re-ordered, as can struct fields
statement ok
COPY (SELECT  {'col2': 400, 'col1': 200} col2, {'j': 20, 'i': 10} col1) TO '${DATA_PATH}/nested2.vortex' (FORMAT vortex);

statement ok
CALL ducklake_add_data_files('ducklake', 'test', '${DATA_PATH}/nested2.vortex')

query II
FROM ducklake.test
----
{'i': 1, 'j': 2}	{'col1': 100, 'col2': 200}
{'i': 10, 'j': 20}	{'col1': 200, 'col2': 400}
