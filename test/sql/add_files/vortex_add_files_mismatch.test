# name: test/sql/add_files/vortex_add_files_mismatch.test
# description: Reject Parquet external files on Vortex-managed tables at add time
# group: [add_files]

require ducklake

require vortex

require parquet

test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db

test-env DATA_PATH __TEST_DIR__

statement ok
SET ducklake_default_data_file_format = 'vortex';

statement ok
ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/ducklake_add_files_mismatch/', METADATA_CATALOG 'metadata');

statement ok
CREATE TABLE ducklake.test(col1 INTEGER, col2 VARCHAR);

statement ok
COPY (SELECT 200 col1, 'world' col2) TO '${DATA_PATH}/wrong.parquet' (FORMAT parquet);

statement error
CALL ducklake_add_data_files('ducklake', 'test', '${DATA_PATH}/wrong.parquet')
----
Cannot add parquet file
