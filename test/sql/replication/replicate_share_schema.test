# name: test/sql/replication/replicate_share_schema.test
# description: share mode preserves logical source schemas when sharing files
# group: [replication]

require ducklake

require parquet

statement ok
ATTACH 'ducklake:{TEST_DIR}/ss_src.db' AS ss_src (DATA_PATH '{TEST_DIR}/ss_src_files')

statement ok
ATTACH 'ducklake:{TEST_DIR}/ss_dst.db' AS ss_dst (DATA_PATH '{TEST_DIR}/ss_dst_files')

# write files directly - share mode cannot represent live inlined rows
statement ok
CALL ducklake_set_option('ss_src', 'data_inlining_row_limit', 0)

# ---------------------------------------------------------------------------
# ADD COLUMN with a default before the first share cycle: files written before
# the column existed read the original default
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE ss_src.main.t (id INTEGER, v VARCHAR)

statement ok
INSERT INTO ss_src.main.t VALUES (1, 'a'), (2, 'b'), (3, 'c')

statement ok
ALTER TABLE ss_src.main.t ADD COLUMN n INTEGER DEFAULT 7

# evolve the current default before the destination ever sees the table
statement ok
ALTER TABLE ss_src.main.t ALTER COLUMN n SET DEFAULT 9

query I
SELECT replication_id FROM ducklake_replicate_create('ss_dst', 'ss_src', data_sync_mode := 'share')
----
1

statement ok
SELECT * FROM ducklake_replicate_catchup('ss_dst', 1)

# exact parity: old rows read the original default on both sides
query III
SELECT id, v, n FROM ss_dst.main.t ORDER BY id
----
1	a	7
2	b	7
3	c	7

query III
SELECT id, v, n FROM ss_src.main.t ORDER BY id
----
1	a	7
2	b	7
3	c	7

# zero copy: the destination registers the source's data path
query I
SELECT data_file LIKE '%ss_src_files%' FROM ducklake_list_files('ss_dst', 't', schema => 'main')
----
true

# a later insert reads the new default through the new file
statement ok
INSERT INTO ss_src.main.t (id, v) VALUES (4, 'd')

statement ok
SELECT * FROM ducklake_replicate_catchup('ss_dst', 1)

query III
SELECT id, v, n FROM ss_dst.main.t ORDER BY id
----
1	a	7
2	b	7
3	c	7
4	d	9

# idempotent catchup re-registers nothing
statement ok
SELECT * FROM ducklake_replicate_catchup('ss_dst', 1)

query I
SELECT COUNT(*) FROM ducklake_list_files('ss_dst', 't', schema => 'main')
----
2

# ---------------------------------------------------------------------------
# RENAME after an initial share: old files carry the pre-rename layout
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE ss_src.main.r (id INTEGER, v VARCHAR)

statement ok
INSERT INTO ss_src.main.r VALUES (10, 'x'), (20, 'y')

statement ok
SELECT * FROM ducklake_replicate_catchup('ss_dst', 1)

query II
SELECT id, v FROM ss_dst.main.r ORDER BY id
----
10	x
20	y

statement ok
ALTER TABLE ss_src.main.r RENAME COLUMN v TO w

statement ok
INSERT INTO ss_src.main.r VALUES (30, 'z')

statement ok
SELECT * FROM ducklake_replicate_catchup('ss_dst', 1)

query II
SELECT id, w FROM ss_dst.main.r ORDER BY id
----
10	x
20	y
30	z

# ---------------------------------------------------------------------------
# DROP COLUMN: dropped fields never reach the destination
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE ss_src.main.d (a INTEGER, b INTEGER, c INTEGER)

statement ok
INSERT INTO ss_src.main.d VALUES (1, 2, 3), (4, 5, 6)

statement ok
SELECT * FROM ducklake_replicate_catchup('ss_dst', 1)

statement ok
ALTER TABLE ss_src.main.d DROP COLUMN b

statement ok
SELECT * FROM ducklake_replicate_catchup('ss_dst', 1)

query II
SELECT a, c FROM ss_dst.main.d ORDER BY a
----
1	3
4	6

# re-adding a same-name column gets a new field id; old files must not leak into it
statement ok
ALTER TABLE ss_src.main.d ADD COLUMN b INTEGER DEFAULT 42

statement ok
SELECT * FROM ducklake_replicate_catchup('ss_dst', 1)

query III
SELECT a, b, c FROM ss_dst.main.d ORDER BY a
----
1	42	3
4	42	6

# ---------------------------------------------------------------------------
# externally added source files (registered name maps) share through the map
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE ss_src.main.ext (id INTEGER, v VARCHAR)

statement ok
COPY (SELECT i::INTEGER AS id, 'v' || i AS v FROM range(3) t(i)) TO '{TEST_DIR}/ext_file.parquet' (FORMAT parquet)

statement ok
SELECT * FROM ducklake_add_data_files('ss_src', 'ext', '{TEST_DIR}/ext_file.parquet')

statement ok
SELECT * FROM ducklake_replicate_catchup('ss_dst', 1)

query II
SELECT id, v FROM ss_dst.main.ext ORDER BY id
----
0	v0
1	v1
2	v2

# ---------------------------------------------------------------------------
# nested columns map recursively
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE ss_src.main.nest (id INTEGER, details STRUCT(x INTEGER, label VARCHAR))

statement ok
INSERT INTO ss_src.main.nest VALUES (1, {'x': 2, 'label': 'a'}), (2, {'x': 3, 'label': 'b'})

statement ok
SELECT * FROM ducklake_replicate_catchup('ss_dst', 1)

query II
SELECT id, details.x FROM ss_dst.main.nest ORDER BY id
----
1	2
2	3

# adding a nested-typed column later: old files read NULL for the whole struct
statement ok
ALTER TABLE ss_src.main.nest ADD COLUMN extra STRUCT(y INTEGER)

statement ok
INSERT INTO ss_src.main.nest VALUES (3, {'x': 9, 'label': 'c'}, {'y': 5})

statement ok
SELECT * FROM ducklake_replicate_catchup('ss_dst', 1)

query III
SELECT id, details.x, extra.y FROM ss_dst.main.nest ORDER BY id
----
1	2	NULL
2	3	NULL
3	9	5

# ---------------------------------------------------------------------------
# dotted field names must not collide with nested mapping paths
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE ss_src.main.dot (id INTEGER, s STRUCT("x.y" INTEGER, x STRUCT(y INTEGER)))

statement ok
INSERT INTO ss_src.main.dot VALUES (1, {'x.y': 11, 'x': {'y': 22}})

statement ok
SELECT * FROM ducklake_replicate_catchup('ss_dst', 1)

query II
SELECT s."x.y", s.x.y FROM ss_dst.main.dot
----
11	22

# ---------------------------------------------------------------------------
# list and map columns keep reading through renames: footer wrapper levels
# never take part in the mapping
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE ss_src.main.lm (id INTEGER, vals INTEGER[], m MAP(INTEGER, VARCHAR))

statement ok
INSERT INTO ss_src.main.lm VALUES (1, [10, 20], map {1: 'a'}), (2, [30], map {2: 'b'})

statement ok
SELECT * FROM ducklake_replicate_catchup('ss_dst', 1)

query III
SELECT id, vals, m FROM ss_dst.main.lm ORDER BY id
----
1	[10, 20]	{1=a}
2	[30]	{2=b}

statement ok
ALTER TABLE ss_src.main.lm RENAME COLUMN vals TO vals2

statement ok
ALTER TABLE ss_src.main.lm RENAME COLUMN m TO m2

statement ok
INSERT INTO ss_src.main.lm VALUES (3, [99], map {3: 'c'})

statement ok
SELECT * FROM ducklake_replicate_catchup('ss_dst', 1)

query III
SELECT id, vals2, m2 FROM ss_dst.main.lm ORDER BY id
----
1	[10, 20]	{1=a}
2	[30]	{2=b}
3	[99]	{3=c}

# a list of structs renamed as a whole: nested fields still resolve through wrappers
statement ok
CREATE TABLE ss_src.main.los (id INTEGER, items STRUCT(a INTEGER, b VARCHAR)[])

statement ok
INSERT INTO ss_src.main.los VALUES (1, [{'a': 1, 'b': 'x'}, {'a': 2, 'b': 'y'}])

statement ok
SELECT * FROM ducklake_replicate_catchup('ss_dst', 1)

statement ok
ALTER TABLE ss_src.main.los RENAME COLUMN items TO elements

statement ok
INSERT INTO ss_src.main.los VALUES (2, [{'a': 3, 'b': 'z'}])

statement ok
SELECT * FROM ducklake_replicate_catchup('ss_dst', 1)

query III
SELECT id, elements[1].a, elements[2].b FROM ss_dst.main.los ORDER BY id
----
1	1	y
2	3	NULL

# an external file with the three-level parquet list layout rides through a rename too
statement ok
CREATE TABLE ss_src.main.el (id INTEGER, nums INTEGER[])

statement ok
COPY (SELECT 1 AS id, [10, 20] AS nums UNION ALL SELECT 2, [30]) TO '{TEST_DIR}/ext_list.parquet' (FORMAT parquet)

statement ok
SELECT * FROM ducklake_add_data_files('ss_src', 'el', '{TEST_DIR}/ext_list.parquet')

statement ok
SELECT * FROM ducklake_replicate_catchup('ss_dst', 1)

query II
SELECT id, nums FROM ss_dst.main.el ORDER BY id
----
1	[10, 20]
2	[30]

statement ok
ALTER TABLE ss_src.main.el RENAME COLUMN nums TO numbers

statement ok
SELECT * FROM ducklake_replicate_catchup('ss_dst', 1)

query II
SELECT id, numbers FROM ss_dst.main.el ORDER BY id
----
1	[10, 20]
2	[30]

# ---------------------------------------------------------------------------
# a recreated source incarnation re-establishes the share table's initial
# missing-field defaults
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE ss_src.main.reid (id INTEGER, v VARCHAR)

statement ok
INSERT INTO ss_src.main.reid VALUES (1, 'a')

statement ok
ALTER TABLE ss_src.main.reid ADD COLUMN n INTEGER DEFAULT 7

query I
SELECT replication_id FROM ducklake_replicate_create('ss_dst', 'ss_src', data_sync_mode := 'share', include := 'main.reid')
----
2

statement ok
SELECT * FROM ducklake_replicate_catchup('ss_dst', 2)

query III
SELECT id, v, n FROM ss_dst.main.reid
----
1	a	7

# new incarnation: files written without n, then n added with a different default
statement ok
DROP TABLE ss_src.main.reid

statement ok
CREATE TABLE ss_src.main.reid (id INTEGER, v VARCHAR)

statement ok
INSERT INTO ss_src.main.reid VALUES (2, 'b'), (3, 'c')

statement ok
ALTER TABLE ss_src.main.reid ADD COLUMN n INTEGER DEFAULT 42

statement ok
SELECT * FROM ducklake_replicate_catchup('ss_dst', 2)

query III
SELECT id, v, n FROM ss_src.main.reid ORDER BY id
----
2	b	42
3	c	42

# source and replica agree
query III
SELECT id, v, n FROM ss_dst.main.reid ORDER BY id
----
2	b	42
3	c	42

# ---------------------------------------------------------------------------
# partitioned and live-inlined sources remain rejected
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE ss_src.main.pt (id INTEGER, p VARCHAR) PARTITIONED BY (p)

statement ok
INSERT INTO ss_src.main.pt VALUES (1, 'a')

statement ok
SELECT * FROM ducklake_replicate_catchup('ss_dst', 1)

query II
SELECT source_table, last_error LIKE '%partitioned%' FROM ducklake_replicate_tables('ss_dst', 1)
WHERE source_table = 'pt'
----
pt	true

# source compaction keeps destination rows and zero-copy sharing intact
statement ok
CALL ducklake_merge_adjacent_files('ss_src', 't', schema => 'main')

statement ok
SELECT * FROM ducklake_replicate_catchup('ss_dst', 1)

query III
SELECT id, v, n FROM ss_dst.main.t ORDER BY id
----
1	a	7
2	b	7
3	c	7
4	d	9

# destination drop + expire never delete source-owned bytes
statement ok
DROP TABLE ss_dst.main.t

statement ok
CALL ducklake_expire_snapshots('ss_dst', older_than => NOW())

query I
SELECT COUNT(*) >= 1 FROM glob('{TEST_DIR}/ss_src_files/**')
----
true

# a fresh catchup re-establishes the share from scratch
statement ok
SELECT * FROM ducklake_replicate_catchup('ss_dst', 1)

query III
SELECT id, v, n FROM ss_dst.main.t ORDER BY id
----
1	a	7
2	b	7
3	c	7
4	d	9

statement ok
DETACH ss_dst

statement ok
DETACH ss_src
