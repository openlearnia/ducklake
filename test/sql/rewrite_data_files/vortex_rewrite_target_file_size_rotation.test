# name: test/sql/rewrite_data_files/vortex_rewrite_target_file_size_rotation.test
# description: rewrite rotates an oversized vortex file into target-sized files, preserving row-ids
# group: [rewrite_data_files]

require ducklake

require vortex

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/vortex_rewrite_rotation', METADATA_CATALOG 'ducklake_metadata', DATA_INLINING_ROW_LIMIT 0)

statement ok
USE dl

statement ok
SET threads TO 1

statement ok
SET ducklake_default_data_file_format = 'vortex'

statement ok
CALL dl.set_option('target_file_size', '512MB')

statement ok
CREATE TABLE t(id BIGINT, payload VARCHAR);

statement ok
INSERT INTO t SELECT i, repeat(md5(i::VARCHAR), 4) FROM range(20000) t(i)

statement ok
DELETE FROM t WHERE id % 10 = 0

statement ok
CALL dl.set_option('target_file_size', '64KB')

# one oversized source file must rotate into multiple files (exact count is format-specific)
query I
SELECT SUM(files_processed) = 1 AND SUM(files_created) > 1 FROM ducklake_rewrite_data_files('dl', 't', delete_threshold => 0)
----
true

# data + row-ids preserved
query II
SELECT SUM(id), SUM(rowid) FROM t
----
180000000	180000000

# every rewritten file respects the target (a single un-rotated file would be ~2.6MB uncompressed)
query I
SELECT MAX(file_size_bytes) < 1000000 FROM ducklake_metadata.ducklake_data_file WHERE end_snapshot IS NULL
----
true

# test with a partition

statement ok
CALL dl.set_option('target_file_size', '512MB')

statement ok
CREATE TABLE p(pk INTEGER, id BIGINT, payload VARCHAR);

statement ok
ALTER TABLE p SET PARTITIONED BY (pk)

statement ok
INSERT INTO p SELECT i % 3, i, repeat(md5(i::VARCHAR), 4) FROM range(30000) t(i)

statement ok
DELETE FROM p WHERE id % 10 = 0

statement ok
CALL dl.set_option('target_file_size', '64KB')

# each of the 3 single-file partitions rotates into multiple files
query I
SELECT SUM(files_processed) = 3 AND SUM(files_created) > 3 FROM ducklake_rewrite_data_files('dl', 'p', delete_threshold => 0)
----
true

# rotation preserves partition isolation: every file belongs to exactly one partition
query I
SELECT COUNT(*) = 0 FROM (
    SELECT pv.partition_value
    FROM ducklake_metadata.ducklake_data_file df
    JOIN ducklake_metadata.ducklake_file_partition_value pv ON df.data_file_id = pv.data_file_id
    WHERE df.end_snapshot IS NULL AND df.table_id = (SELECT table_id FROM ducklake_metadata.ducklake_table WHERE table_name = 'p')
    GROUP BY pv.partition_value
    HAVING COUNT(*) < 2
)
----
true

# data + row-ids preserved
query II
SELECT SUM(id), SUM(rowid) FROM p
----
405000000	404991000
