# name: test/sql/snapshot_info/ducklake_protect_snapshots.test
# description: protected snapshots are retained by ducklake_expire_snapshots unless forced
# group: [snapshot_info]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/protect_snapshots', METADATA_CATALOG 'metadata', DATA_INLINING_ROW_LIMIT 0)

# snapshot 1
statement ok
CREATE TABLE ducklake.tbl (i INTEGER)

# snapshot 2
statement ok
INSERT INTO ducklake.tbl VALUES (1)

# snapshot 3
statement ok
INSERT INTO ducklake.tbl VALUES (2)

# snapshot 4
statement ok
INSERT INTO ducklake.tbl VALUES (3)

# snapshots are 0 (init), 1 (create), 2, 3, 4 (inserts)
query I
SELECT count(*) FROM ducklake.snapshots() WHERE protected
----
0

# ---------------------------------------------------------------------------
# Protect snapshot 2
# ---------------------------------------------------------------------------

query I
SELECT snapshot_id FROM ducklake_protect_snapshots('ducklake', versions => [2])
----
2

query II
SELECT snapshot_id, protected FROM ducklake.snapshots() ORDER BY snapshot_id
----
0	false
1	false
2	true
3	false
4	false

# protecting an already-protected snapshot is a no-op, not a duplicate row
query I
SELECT count(*) FROM ducklake_protect_snapshots('ducklake', versions => [2])
----
0

query I
SELECT count(*) FROM metadata.ducklake_snapshot_protection WHERE protected_snapshot_id = 2
----
1

# ---------------------------------------------------------------------------
# Expiry skips protected snapshots
# ---------------------------------------------------------------------------

# 4 is the newest and so is never expirable; 2 is protected
query I
SELECT snapshot_id FROM ducklake_expire_snapshots('ducklake', versions => [1, 2, 3, 4], dry_run => true) ORDER BY snapshot_id
----
1
3

statement ok
CALL ducklake_expire_snapshots('ducklake', versions => [1, 2, 3, 4])

query II
SELECT snapshot_id, protected FROM ducklake.snapshots() ORDER BY snapshot_id
----
0	false
2	true
4	false

# ---------------------------------------------------------------------------
# The held snapshot is still time-travellable
# ---------------------------------------------------------------------------

query I
SELECT sum(i) FROM ducklake.tbl AT (VERSION => 2)
----
1

# ---------------------------------------------------------------------------
# force overrides protection
# ---------------------------------------------------------------------------

query I
SELECT snapshot_id FROM ducklake_expire_snapshots('ducklake', versions => [2], dry_run => true, force => true)
----
2

statement ok
CALL ducklake_expire_snapshots('ducklake', versions => [2], force => true)

query I
SELECT snapshot_id FROM ducklake.snapshots() ORDER BY snapshot_id
----
0
4

# a forced expiry clears the hold rather than orphaning it
query I
SELECT count(*) FROM metadata.ducklake_snapshot_protection
----
0

statement error
SELECT sum(i) FROM ducklake.tbl AT (VERSION => 2)
----
No snapshot found

# ---------------------------------------------------------------------------
# Release protection, then expire normally
# ---------------------------------------------------------------------------

# snapshot 5
statement ok
INSERT INTO ducklake.tbl VALUES (4)

query I
SELECT snapshot_id FROM ducklake_protect_snapshots('ducklake', versions => [5])
----
5

query I
SELECT count(*) FROM metadata.ducklake_snapshot_protection
----
1

# releasing reports the snapshot, with `protected` reflecting the post-state
query II
SELECT snapshot_id, protected FROM ducklake_protect_snapshots('ducklake', versions => [5], protect => false)
----
5	false

query I
SELECT count(*) FROM metadata.ducklake_snapshot_protection
----
0

# snapshot 6, so that 5 is no longer the newest and becomes expirable
statement ok
INSERT INTO ducklake.tbl VALUES (5)

# with the hold gone, expiry is free to drop it
statement ok
CALL ducklake_expire_snapshots('ducklake', versions => [5])

query I
SELECT snapshot_id FROM ducklake.snapshots() ORDER BY snapshot_id
----
0
4
6

# ---------------------------------------------------------------------------
# older_than selection
# ---------------------------------------------------------------------------

query I
SELECT count(*) FROM ducklake_protect_snapshots('ducklake', older_than => NOW())
----
3

query I
SELECT count(*) FROM ducklake.snapshots() WHERE protected
----
3

# 6 is the newest and every other snapshot is now held, so nothing is expirable
query I
SELECT count(*) FROM ducklake_expire_snapshots('ducklake', older_than => NOW())
----
0

query I
SELECT count(*) FROM ducklake_protect_snapshots('ducklake', older_than => NOW(), protect => false)
----
3

query I
SELECT count(*) FROM ducklake.snapshots() WHERE protected
----
0

# ---------------------------------------------------------------------------
# Argument validation, mirroring ducklake_expire_snapshots
# ---------------------------------------------------------------------------

statement error
SELECT * FROM ducklake_protect_snapshots('ducklake', versions => [1], older_than => NOW())
----
cannot specify both 'versions' and 'older_than'

query I
SELECT count(*) FROM ducklake_protect_snapshots('ducklake', versions => [])
----
0

query I
SELECT count(*) FROM ducklake_protect_snapshots('ducklake', versions => NULL)
----
0

query I
SELECT count(*) FROM ducklake_protect_snapshots('ducklake', versions => [NULL])
----
0

# no criterion at all is a silent no-op
query I
SELECT count(*) FROM ducklake_protect_snapshots('ducklake')
----
0

# a snapshot id that does not exist cannot be protected
query I
SELECT count(*) FROM ducklake_protect_snapshots('ducklake', versions => [9999])
----
0

query I
SELECT count(*) FROM metadata.ducklake_snapshot_protection
----
0
