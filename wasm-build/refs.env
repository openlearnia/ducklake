# Reproducible inputs for the browser playground build.
# The DuckDB-Wasm source ref supplies the build harness; the custom DuckDB
# source ref is tracked by .github/duckdb-ref and verified by verify-refs.sh.
DUCKDB_WASM_REF=v1.33.0
DUCKDB_WASM_NPM_VERSION=1.11.0
EMSDK_VERSION=3.1.71
VCPKG_COMMIT=84bab45d415d22042bd0b9081aea57f362da3f35
VCPKG_TARGET_TRIPLET=wasm32-emscripten
DUCKDB_REF_FILE=.github/duckdb-ref
